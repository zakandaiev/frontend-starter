{
  "name": "frontend-starter",
  "version": "2.7.0",
  "private": false,
  "author": "Oleksandr Zakandaiev",
  "authorUrl": "https://github.com/zakandaiev",
  "description": "FrontEnd Starter is a boilerplate kit for easy building modern static web-sites using Gulp",
  "keywords": [
    "gulp",
    "builder",
    "frontend",
    "starter",
    "boilerplate",
    "kit",
    "twig",
    "html",
    "css",
    "sass",
    "scss",
    "javascript",
    "js",
    "es6",
    "optimized",
    "autoprefixer",
    "rolldown",
    "browsersync",
    "404",
    "grid",
    "htaccess",
    "robots.txt",
    "sitemap.xml",
    "favicon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zakandaiev/frontend-starter"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#root/*": "./*",
    "#core/*": "./core/*",
    "#src/*": "./src/*"
  },
  "browserslist": [
    "last 15 versions",
    "not dead"
  ],
  "scripts": {
    "dev": "gulp",
    "build": "gulp --build",
    "preview": "gulp preview --build",
    "docs": "gulp --build --base=/frontend-starter --dist=./docs",
    "lint:js": "eslint ./",
    "lint:js:fix": "eslint ./ --fix",
    "lint:css": "stylelint ./src/sass/**/*.{sass,scss}",
    "lint:css:fix": "stylelint ./src/sass/**/*.{sass,scss} --fix",
    "backend": "nodemon backend",
    "debug:sourcemap": "node sourcemap"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-url": "^8.0.2",
    "autoprefixer": "^10.5.0",
    "browser-sync": "^3.0.4",
    "cssnano": "^8.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "fastify": "^5.8.5",
    "globals": "^17.6.0",
    "gulp": "^5.0.1",
    "gulp-htmlmin": "^5.0.1",
    "gulp-if": "^3.0.0",
    "gulp-imagemin": "^9.2.0",
    "gulp-newer": "^1.4.0",
    "gulp-postcss": "^10.0.0",
    "gulp-sass": "^6.0.1",
    "gulp-twig": "^1.2.0",
    "gulp-version-number": "^0.2.4",
    "minimist": "^1.2.8",
    "nodemon": "^3.1.14",
    "postcss-combine-media-query": "^2.1.0",
    "rolldown": "^1.0.1",
    "sass": "^1.99.0",
    "stylelint": "^17.11.1",
    "stylelint-config-clean-order": "^8.0.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.1.1"
  },
  "dependencies": {
    "@tabler/icons": "^3.44.0",
    "reseter.css": "^2.0.0"
  },
  "overrides": {
    "eslint": "^10.4.0"
  }
}
